# AuthZ Guard Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# Node environment: 'development', 'production', or 'test'
NODE_ENV=development

# Server port
PORT=3000

# SQLite database file path (relative to project root or absolute)
DATABASE_PATH=./data/authz.db

# OAuth2 / OIDC Trusted Issuer URL (must match 'iss' claim in tokens)
OIDC_ISSUER_URL=https://auth.example.com

# OAuth2 / OIDC API Expected Audience (must match 'aud' claim in tokens)
OIDC_AUDIENCE=https://api.example.com/v1

# Optional: Explicit JWKS URL (if discovery at /.well-known/jwks.json is not used)
# OIDC_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# Rate limiting window in milliseconds (default: 60000ms = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per IP per rate limit window (default: 100)
RATE_LIMIT_MAX=100

# Structured logging level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# Trust proxy configuration (for reverse proxies like Nginx/Cloudflare): 'true' or 'false'
TRUST_PROXY=false

# Maximum request body size in bytes (default: 16384 = 16KB)
MAX_REQUEST_BODY_BYTES=16384
